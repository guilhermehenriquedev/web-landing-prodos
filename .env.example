# Endereço público do site (canonical, sitemap, Open Graph). Sem barra no fim.
SITE_URL=http://localhost:3000
# API pública do site no Gestão (contrato v2).
GESTAO_API_URL=http://localhost:8000/api/public/site/v2
# Mesmo valor de LANDING_REVALIDAR_SEGREDO no Gestão. Gere com: openssl rand -hex 32
GESTAO_REVALIDAR_SEGREDO=
# Tempo máximo de espera pela API do Gestão, em milissegundos.
GESTAO_API_TIMEOUT_MS=4000
# Onde fica a última cópia das respostas do Gestão (usada se ele cair). Padrão: .next/cache/gestao
# SITE_CACHE_DIR=
